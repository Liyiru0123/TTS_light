{
  "schema_version": 1,
  "policy_id": "color_shape_compositional_holdouts_v1",
  "authority": {
    "path": "data/datasets/p1_w03_v1/manifest.json",
    "json_path": "$.compositional_report.holdout_pairs"
  },
  "colors": ["red", "blue", "green", "yellow", "purple", "orange"],
  "shapes": ["circle", "square", "triangle", "rectangle", "pentagon"],
  "holdout_pairs": [
    "blue|square",
    "green|triangle",
    "purple|pentagon",
    "red|circle",
    "yellow|rectangle"
