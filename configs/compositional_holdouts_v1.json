  "allowed_training_pairs": [
    "blue|circle",
    "blue|pentagon",
    "blue|rectangle",
    "blue|triangle",
    "green|circle",
    "green|pentagon",
    "green|rectangle",
    "green|square",
    "orange|circle",
    "orange|pentagon",
    "orange|rectangle",
    "orange|square",
    "orange|triangle",
    "purple|circle",
    "purple|rectangle",
    "purple|square",
    "purple|triangle",
    "red|pentagon",
    "red|rectangle",
    "red|square",
    "red|triangle",
    "yellow|circle",
    "yellow|pentagon",
    "yellow|square",
    "yellow|triangle"
  ],
  "rules": {
    "source_data_is_immutable": true,
    "filter_entire_record_if_any_object_is_holdout": true,
    "training_holdout_object_count_must_equal": 0,
    "claim_requires_training_exclusion_and_evaluation_inclusion": true
